    assign pready = 1'b1;

    // Synchronous Sequential Block (Counter & Write Logic)
    always_ff @(posedge pclk or negedge presetn) begin
        if (!presetn) begin
            reg_ctrl      <= '0;
            reg_prescale  <= '0;
            reg_reload    <= '0;
            reg_value     <= '0;
            prescaler_cnt <= '0;
            reg_intstat   <= 1'b0;
        end else begin
